{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4:26b-a4b-it-qat-64k",
  "lsp": {
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    },
    "r": {
      "command": ["/opt/conda/envs/gds/bin/R", "--slave", "-e", "languageserver::run()"],
      "extensions": [".R", ".r", ".Rmd", ".rmd"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh"]
    },
    "markdown": {
      "command": ["vscode-markdown-language-server", "--stdio"],
      "extensions": [".md"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "json": {
      "command": ["vscode-json-language-server", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "dockerfile": {
      "command": ["docker-langserver", "--stdio"],
      "extensions": ["Dockerfile", ".dockerfile"]
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://{env:OLLAMA_HOST}/v1"
      },
      "models": {
        "qwen3.8:27b-mlx-64k-mid-thinking": {
          "name": "qwen3.8:27b-mlx-64k-mid-thinking",
          "tool_call": true
        },
          "muse-glimmer:30b-mlx": {
            "name": "muse-glimmer:30b-mlx",
            "tool_call": true
          },
          "gemma4:26b-a4b-it-qat-64k": {
          "name": "gemma4:26b-a4b-it-qat-64k",
          "tool_call": true
        },
        "gemma4:26b-a4b-it-qat": {
          "name": "gemma4:26b-a4b-it-qat",
          "tool_call": true
        },
        "gemma4:26b-mlx": {
          "name": "gemma4:26b-mlx",
          "tool_call": true
        },
        "gemma4:12b-it-qat-128k": {
          "name": "gemma4:12b-it-qat-128k",
          "tool_call": true
        },
        "gemma4:12b-it-qat": {
          "name": "gemma4:12b-it-qat",
          "tool_call": true
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI Compatible",
      "options": {
        "baseURL": "http://{env:OPENAI_HOST}/v1"
      },
      "models": {
        "bonsai-27b": {
          "name": "bonsai-27b",
          "tool_call": true
        }
      }
    }
  }
}
